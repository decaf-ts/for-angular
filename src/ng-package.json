{
  "$schema": "../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../dist/lib",
  "lib": {
    "entryFile": "lib/public-apis.ts",
    "styleIncludePaths": [
      "./assets"
    ]
  },
  "inlineStyleLanguage": "scss",
  "assets": [
    {
      "glob": "**/*",
      "input": "assets",
      "output": "assets",
      "ignore": [
        "images/ew/**"
      ]
    },
    {
      "glob": "**/*",
      "input": "diagrams/assets",
      "output": "diagrams/assets"
    },
    {
      "glob": "README.md",
      "input": "kanban",
      "output": "kanban"
    },
    {
      "glob": "README.md",
      "input": "scrum",
      "output": "scrum"
    },
    {
      "glob": "README.md",
      "input": "gantt",
      "output": "gantt"
    },
    {
      "glob": "README.md",
      "input": "calendar",
      "output": "calendar"
    },
    {
      "glob": "README.md",
      "input": "charts",
      "output": "charts"
    },
    {
      "glob": "README.md",
      "input": "math",
      "output": "math"
    },
    {
      "glob": "README.md",
      "input": "code-editor",
      "output": "code-editor"
    },
    {
      "glob": "README.md",
      "input": "barcode",
      "output": "barcode"
    },
    {
      "glob": "README.md",
      "input": "diagrams",
      "output": "diagrams"
    },
    {
      "glob": "README.md",
      "input": "agent",
      "output": "agent"
    },
    {
      "glob": "README.md",
      "input": "cron",
      "output": "cron"
    },
    {
      "glob": "README.md",
      "input": "storyboard",
      "output": "storyboard"
    },
    {
      "glob": "LICENSE.md",
      "input": ".",
      "output": "."
    },
    {
      "glob": "NOTICE",
      "input": ".",
      "output": "."
    }
  ]
}
