/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // Specs import app/lib code through `src/...` paths; without a baseUrl the
    // ts-jest type check cannot resolve them and the suites fail to load.
    "baseUrl": ".",
    "module": "CommonJs",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "files": [
    // "src/karmaTest.ts", // Uncomment if using Karma. Commented out to avoid conflict with Jest.
    "src/polyfills.ts"
  ],
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
